{
  "name": "@aifirst/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "tsx src/server.ts",
    "start:docker": "tsx src/docker-entrypoint.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@aifirst/db": "workspace:*",
    "@aifirst/shared": "workspace:*",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.8",
    "nodemailer": "7.0.13",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/nodemailer": "7.0.12",
    "vitest": "3.2.7"
  }
}
